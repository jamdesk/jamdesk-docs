{
  "$schema": "https://www.jamdesk.com/docs.json",
  "theme": "jam",
  "seo": {
    "metatags": {
      "robots": "noindex"
    }
  },
  "name": "Jamdesk Documentation",
  "description": "Build, deploy, and maintain documentation sites with Jamdesk",
  "api": {
    "openapi": [
      "/openapi/acme-support.yaml"
    ]
  },
  "colors": {
    "primary": "#635BFF",
    "light": "#7C75FF",
    "dark": "#4F46E5"
  },
  "favicon": "/images/jamdesk-icon-light-1024.png",
  "logo": {
    "light": "/images/logo-light.webp",
    "dark": "/images/logo-dark.webp",
    "href": "https://jamdesk.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Blog",
        "href": "https://www.jamdesk.com/blog"
      },
      {
        "label": "Pricing",
        "href": "https://www.jamdesk.com/pricing"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.jamdesk.com"
    }
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/jamdesk",
      "x": "https://x.com/JamdeskHQ",
      "github": "https://github.com/jamdesk"
    }
  },
  "tabsPosition": "left",
  "redirects": [
    { "source": "/development/ai-writing", "destination": "/ai/writing-with-ai" },
    { "source": "/development/ai-documentation", "destination": "/ai/automated-updates" },
    { "source": "/development/mcp-integration", "destination": "/ai/mcp-server" },
    { "source": "/development/markdown-source", "destination": "/ai/markdown-source" },
    { "source": "/ai/raw-content", "destination": "/ai/markdown-source" }
  ],
  "navigation": {
    "tabs": [
