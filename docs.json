{
  "$schema": "https://jamdesk.com/docs.json",
  "name": "Jamdesk Documentation",
  "description": "Learn how to build beautiful documentation sites with Jamdesk",
  "theme": "jam",
  "colors": {
    "primary": "#635BFF",
    "light": "#7C75FF",
    "dark": "#4F46E5"
  },
  "favicon": "/images/favicon.svg",
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg",
    "href": "https://jamdesk.com"
  },
  "navbar": {
    "links": [
      { "label": "Blog", "href": "https://www.jamdesk.com/blog" },
      { "label": "Pricing", "href": "https://www.jamdesk.com/pricing" }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.jamdesk.com"
    }
  },
  "navigation": {
    "anchors": [
      {
        "anchor": "Docs",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["introduction", "quickstart", "how-jamdesk-works"]
          },
          {
            "group": "Writing Content",
            "pages": ["content/code-blocks"]
          },
          {
            "group": "Components",
            "pages": ["components/overview"]
          },
          {
            "group": "Configuration",
            "pages": ["config/docs-json-reference"]
          }
        ]
      }
    ]
  }
}
