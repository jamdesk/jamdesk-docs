{
  "$schema": "https://www.jamdesk.com/docs.json",
  "theme": "jam",
  "name": "Jamdesk Documentation",
  "description": "Build, deploy, and maintain documentation sites with Jamdesk",
  "chat": {
    "enabled": true
  },
  "api": {
    "openapi": [
      "/openapi/acme-support.yaml"
    ]
  },
  "colors": {
    "primary": "#635BFF",
    "light": "#7C75FF",
    "dark": "#4F46E5"
  },
  "favicon": "/images/jamdesk-icon-light-1024.png",
  "logo": {
    "light": "/images/logo-light.webp",
    "dark": "/images/logo-dark.webp",
    "href": "https://jamdesk.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Blog",
        "href": "https://www.jamdesk.com/blog"
      },
      {
        "label": "Pricing",
        "href": "https://www.jamdesk.com/pricing"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.jamdesk.com"
    }
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/jamdesk",
      "x": "https://x.com/JamdeskHQ",
      "github": "https://github.com/jamdesk"
    }
  },
  "tabsPosition": "left",
  "redirects": [
    {
      "source": "/development/ai-writing",
      "destination": "/ai/writing-with-ai"
    },
    {
      "source": "/development/ai-documentation",
      "destination": "/ai/automated-updates"
    },
    {
      "source": "/development/mcp-integration",
      "destination": "/ai/mcp-server"
    },
    {
      "source": "/development/markdown-source",
      "destination": "/ai/markdown-source"
    },
    {
      "source": "/ai/raw-content",
      "destination": "/ai/markdown-source"
    },
    {
      "source": "/reference/builds-api",
      "destination": "/help/builds/triggering"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get Started",
            "icon": "light/rocket",
            "pages": [
              "introduction",
              "quickstart",
              {
                "page": "end-to-end-tutorial",
                "title": "End-to-End Tutorial"
              },
              "how-jamdesk-works",
              "troubleshooting"
            ]
          },
          {
            "group": "Project Setup",
            "icon": "light/folder-gear",
            "pages": [
              "setup/creating-projects",
              {
                "page": "setup/connecting-github",
                "title": "Connect GitHub"
              },
              "setup/directory-structure",
              "setup/migration",
