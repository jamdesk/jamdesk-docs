{
  "$schema": "https://www.jamdesk.com/docs.json",
  "theme": "jam",
  "seo": {
    "metatags": {
      "robots": "noindex"
    }
  },
  "name": "Jamdesk Documentation",
  "description": "Learn how to build beautiful documentation sites with Jamdesk",
  "colors": {
    "primary": "#635BFF",
    "light": "#7C75FF",
    "dark": "#4F46E5"
  },
  "favicon": "/images/jamdesk-icon-light-1024.png",
  "logo": {
    "light": "/images/logo-light-2772.png",
    "dark": "/images/logo-dark-2772.png",
    "href": "https://jamdesk.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Blog",
        "href": "https://www.jamdesk.com/blog"
      },
      {
        "label": "Pricing",
        "href": "https://www.jamdesk.com/pricing"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.jamdesk.com"
    }
  },
  "tabsPosition": "left",
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["introduction", "quickstart", "how-jamdesk-works"]
          },
          {
            "group": "Project Setup",
            "pages": [
              "setup/creating-projects",
              "setup/connecting-github",
              "setup/directory-structure",
              "setup/monorepo-support",
              "setup/analytics"
            ]
          },
          {
            "group": "Development",
            "pages": [
              "cli/overview",
              "development/local-preview",
              "development/deployment"
            ]
          },
          {
            "group": "Deployment",
            "pages": [
              "deploy/overview",
              "deploy/cloudflare",
              "deploy/aws",
              "deploy/vercel",
              "deploy/reverse-proxy"
            ]
          },
          {
            "group": "Writing Content",
            "pages": [
              "content/mdx-basics",
              "content/headers",
              "content/code-blocks",
              "content/math",
              "content/media-embeds",
              "content/icons",
              "content/links",
              "content/frontmatter"
            ]
          },
          {
            "group": "Components",
            "pages": [
              "components/overview",
              "components/card",
              "components/tabs",
              "components/accordion",
              "components/steps",
              "components/callouts",
              "components/update",
              "components/expandable",
              "components/frame",
              "components/code-group",
              "components/tables",
              "components/tooltip"
            ]
          },
          {
            "group": "Customization",
            "pages": [
              "customization/theming",
              "customization/branding",
              "navigation/overview"
            ]
          },
          {
            "group": "Reference",
            "pages": ["config/docs-json-reference"]
          }
        ]
      },
      {
        "tab": "Help Center",
        "icon": "life-ring",
        "groups": [
          {
            "group": "Dashboard",
            "pages": ["help/github-integration", "help/github-app"]
          }
        ]
      }
    ]
  }
}
