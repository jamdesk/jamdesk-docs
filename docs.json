{
  "$schema": "https://www.jamdesk.com/docs.json",
  "theme": "jam",
  "name": "Jamdesk Documentation",
  "description": "Jamdesk is a software documentation tool for building, deploying, and maintaining docs sites",
  "chat": {
    "enabled": true
  },
  "spellcheck": {
    "ignore": ["Coolors", "Cobo", "aspirational", "ons", "ord"]
  },
  "api": {
    "openapi": [
      "/openapi/example-api.yaml",
      "/openapi/knowledge-api.yaml"
    ],
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript",
        "go",
        "ruby",
        "csharp",
        "java",
        "rust",
        "php"
      ]
    },
    "mdx": {
      "server": "https://jamdesk-docs.jamdesk.app/api/playground/demo"
    }
  },
  "colors": {
    "primary": "#635BFF",
    "light": "#7C75FF",
    "dark": "#4F46E5"
  },
  "integrations": {
    "plausible": {
      "scriptUrl": "https://plausible.io/js/pa-T8xasrsvCekiUJAMZbXIC.js"
    }
  },
  "favicon": "/images/jamdesk-icon-light-1024.png",
  "logo": {
    "light": "/images/logo-light.webp",
    "dark": "/images/logo-dark.webp",
    "href": "https://www.jamdesk.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Blog",
        "href": "https://www.jamdesk.com/blog"
      },
      {
        "label": "Pricing",
        "href": "https://www.jamdesk.com/pricing"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.jamdesk.com"
    }
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/jamdesk",
      "x": "https://x.com/JamdeskHQ",
      "github": "https://github.com/jamdesk"
    }
  },
  "tabsPosition": "left",
  "redirects": [
    {
      "source": "/development/ai-writing",
      "destination": "/ai/writing-with-ai"
    },
    {
      "source": "/development/ai-documentation",
      "destination": "/ai/automated-updates"
    },
    {
      "source": "/development/mcp-integration",
      "destination": "/ai/mcp-server"
    },
    {
      "source": "/development/markdown-source",
      "destination": "/ai/markdown-source"
    },
    {
      "source": "/ai/raw-content",
      "destination": "/ai/markdown-source"
    },
    {
      "source": "/reference/builds-api",
      "destination": "/builds/triggering"
    },
    {
      "source": "/help/builds/:slug*",
      "destination": "/builds/:slug*"
    },
    {
      "source": "/help/google-analytics",
      "destination": "/integrations/google-analytics"
    },
    {
      "source": "/help/google-tag-manager",
      "destination": "/integrations/google-tag-manager"
    },
    {
      "source": "/help/plausible-analytics",
      "destination": "/integrations/plausible-analytics"
    },
    {
      "source": "/help/github-integration",
      "destination": "/integrations/github"
    },
    {
      "source": "/help/slack-integration",
      "destination": "/integrations/slack"
    },
    {
      "source": "/help/analytics/overview",
      "destination": "/setup/analytics-overview"
    },
    {
      "source": "/help/analytics/search-analytics",
      "destination": "/setup/search-analytics"
    },
    {
      "source": "/help/custom-domains",
      "destination": "/deploy/custom-domains"
    },
    {
      "source": "/help/domains/subdomains",
      "destination": "/deploy/subdomains"
    },
    {
      "source": "/essentials/markdown",
      "destination": "/ai/markdown-source"
    },
    {
      "source": "/getting-started/quickstart",
      "destination": "/quickstart"
    },
    {
      "source": "/content/media-embeds",
      "destination": "/content/images"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get Started",
            "icon": "light/rocket",
            "pages": [
              "introduction",
              "quickstart",
              {
                "page": "end-to-end-tutorial",
                "title": "End-to-End Tutorial"
              },
              "how-jamdesk-works",
              "troubleshooting"
            ]
          },
          {
            "group": "Project Setup",
            "icon": "light/folder-gear",
            "pages": [
              "setup/creating-projects",
              {
                "page": "setup/connecting-github",
                "title": "Connect GitHub"
              },
              "setup/directory-structure",
              "setup/migration",
